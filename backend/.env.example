# Supabase Configuration
# Obtain from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mailgun Configuration
# Obtain from your Mailgun Dashboard -> API Keys / Sending -> Domains
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=sandbox-or-your-custom-domain.mailgun.org
MAILGUN_API_BASE_URL=https://api.mailgun.net/v3
# Use https://api.eu.mailgun.net/v3 if your domain is in the EU region
MAILGUN_FROM_EMAIL=HNG Tech Shop <postmaster@sandbox-or-your-custom-domain.mailgun.org>

# Frontend URL
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
